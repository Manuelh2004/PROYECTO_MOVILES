<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D9E1E6"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:spacing="16dp">

        <!-- EditText para Nombres -->
        <EditText
            android:id="@+id/nombres"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/rounded_edittext"
            android:hint="Nombres"
            android:textColor="#FFFFFF"
            android:padding="12dp"
            android:textSize="16sp"
            android:inputType="textPersonName"
            android:layout_marginBottom="12dp" />

        <!-- EditText para Apellidos -->
        <EditText
            android:id="@+id/apellidos"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/rounded_edittext"
            android:hint="Apellidos"
            android:textColor="#FFFFFF"
            android:padding="12dp"
            android:textSize="16sp"
            android:inputType="textPersonName"
            android:layout_marginBottom="12dp" />

        <!-- Spinner para Genero -->
        <Spinner
            android:id="@+id/genero"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/rounded_edittext"
            android:padding="12dp"
            android:layout_marginBottom="12dp" />

        <!-- Spinner para Pais -->
        <Spinner
            android:id="@+id/pais"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/rounded_edittext"
            android:padding="12dp"
            android:layout_marginBottom="12dp" />

        <!-- Spinner para Tipo de Documento -->
        <Spinner
            android:id="@+id/tipo_documento"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/rounded_edittext"
            android:padding="12dp"
            android:layout_marginBottom="12dp" />

        <!-- EditText para Número de Documento -->
        <EditText
            android:id="@+id/numero_documento"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/rounded_edittext"
            android:hint="Número de Document"
            android:textColor="#FFFFFF"
            android:padding="12dp"
            android:textSize="16sp"
            android:inputType="number"
            android:layout_marginBottom="12dp" />

        <!-- EditText para Fecha de Nacimiento -->
        <EditText
            android:id="@+id/fecha_nacimiento"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/rounded_edittext"
            android:hint="Fecha de Nacimiento"
            android:textColor="#FFFFFF"
            android:padding="12dp"
            android:textSize="16sp"
            android:inputType="date"
            android:layout_marginBottom="12dp" />

        <!-- EditText para Telefono -->
        <EditText
            android:id="@+id/telefono"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/rounded_edittext"
            android:hint="Telefono"
            android:textColor="#FFFFFF"
            android:padding="12dp"
            android:textSize="16sp"
            android:inputType="phone"
            android:layout_marginBottom="24dp" />

        <!-- Botón Crear -->
        <Button
            android:id="@+id/btn_crear"
            android:layout_width="200dp"
            android:layout_height="48dp"
            android:background="@drawable/btn_crear"
            android:text="Crear"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- Botón Cancelar -->
        <Button
            android:id="@+id/btn_cancelar"
            android:layout_width="200dp"
            android:layout_height="48dp"
            android:background="@drawable/btn_cancelar"
            android:text="Cancelar"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
