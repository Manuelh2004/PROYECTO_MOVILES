<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:background="@color/fondo_moviles">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardEgresos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:text="Análisis Visual de Egresos"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"/>

                <!-- Título del gráfico PieChart -->
                <TextView
                    android:id="@+id/tvTituloPie"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Distribución de Egresos"
                    android:textAlignment="center"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:layout_marginBottom="8dp" />

                <!-- Contenedor PieChart + Mensaje -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginBottom="16dp">

                    <com.github.mikephil.charting.charts.PieChart
                        android:id="@+id/pieChartEgresos"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>

                    <TextView
                        android:id="@+id/tvSinDatosPie"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="No hay datos de distribución de egresos.\nRegistra movimientos para ver el gráfico 📊"
                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:visibility="gone"/>
                </FrameLayout>

                <!-- Título del gráfico BarChart -->
                <TextView
                    android:id="@+id/tvTituloBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Egresos Mensuales"
                    android:textAlignment="center"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:layout_marginBottom="8dp" />

                <!-- Contenedor BarChart + Mensaje -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="250dp"
                    android:layout_marginBottom="16dp">

                    <com.github.mikephil.charting.charts.BarChart
                        android:id="@+id/barChartEgresosMensuales"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>

                    <TextView
                        android:id="@+id/tvSinDatosBar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="No hay datos de egresos mensuales.\nAgrega movimientos para analizar por mes 📈"
                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:visibility="gone"/>
                </FrameLayout>

                <!-- Leyenda personalizada debajo de los gráficos -->
                <LinearLayout
                    android:id="@+id/leyendaPersonalizada"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp" />

                <!-- Botón de actualización -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnActualizarGraficos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Actualizar Gráficos"
                    app:backgroundTint="@color/color_botones"
                    android:textColor="@android:color/white"
                    app:cornerRadius="24dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>



